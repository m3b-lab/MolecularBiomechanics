; Energy minimisation (steepest descent)
; gromos54a7 + SPC: reaction field, 1.4 nm cut-offs

integrator      = steep
emtol           = 100.0     ; stop when the largest force is below 100 kJ mol-1 nm-1
emstep          = 0.01      ; initial step size (nm)
nsteps          = 50000     ; upper limit; usually converges much earlier

; Output
nstenergy       = 100
nstlog          = 100

; Neighbour searching and interactions: GROMOS 54A7 settings
; GROMOS was parametrized with reaction-field electrostatics and a 1.4 nm
; cut-off (Diem & Oostenbrink, JCTC 2020, doi:10.1021/acs.jctc.0c00509).
; A single 1.4 nm Verlet cut-off reproduces the original twin-range scheme
; (Silva et al., JCTC 2018, doi:10.1021/acs.jctc.8b00758).
cutoff-scheme   = Verlet
nstlist         = 10
pbc             = xyz
coulombtype     = Reaction-Field
rcoulomb        = 1.4
epsilon-rf      = 61        ; dielectric medium beyond the cut-off, as in GROMOS
vdwtype         = Cut-off
rvdw            = 1.4
DispCorr        = no        ; GROMOS applies no long-range dispersion correction
