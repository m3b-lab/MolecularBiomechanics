; Energy minimisation (steepest descent)
; Course standard: amber99sb-ildn + TIP3P, PME, 1.0 nm cut-offs

integrator      = steep
emtol           = 100.0     ; stop when the largest force is below 100 kJ mol-1 nm-1
emstep          = 0.01      ; initial step size (nm)
nsteps          = 50000     ; upper limit; usually converges much earlier

; Output
nstenergy       = 100
nstlog          = 100

; Neighbour searching and interactions
cutoff-scheme   = Verlet
nstlist         = 10
pbc             = xyz
coulombtype     = PME
rcoulomb        = 1.0
vdwtype         = Cut-off
rvdw            = 1.0
DispCorr        = EnerPres
