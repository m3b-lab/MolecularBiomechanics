; NPT equilibration, 500 ps at 300 K and 1 bar, protein heavy atoms restrained
; Course standard: amber99sb-ildn + TIP3P, dt = 2 fs, h-bond constraints, no HMR

define          = -DPOSRES  ; position restraints from posre.itp
integrator      = md
dt              = 0.002     ; 2 fs
nsteps          = 250000    ; 500 ps

; Output
nstxout-compressed = 5000   ; every 10 ps
nstenergy       = 500
nstlog          = 500

; Bonds
continuation    = yes       ; continues from the NVT stage
constraints     = h-bonds
constraint-algorithm = lincs
lincs-iter      = 1
lincs-order     = 4

; Neighbour searching and interactions
cutoff-scheme   = Verlet
nstlist         = 10
pbc             = xyz
coulombtype     = PME
rcoulomb        = 1.0
vdwtype         = Cut-off
rvdw            = 1.0
DispCorr        = EnerPres

; Temperature coupling
tcoupl          = v-rescale
tc-grps         = System
tau-t           = 0.1
ref-t           = 300

; Pressure coupling: C-rescale samples the correct NPT ensemble (Berendsen does not)
pcoupl          = C-rescale
pcoupltype      = isotropic
tau-p           = 2.0
ref-p           = 1.0
compressibility = 4.5e-5
refcoord-scaling = com

gen-vel         = no
