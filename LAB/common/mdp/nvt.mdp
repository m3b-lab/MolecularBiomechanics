; NVT equilibration, 100 ps at 300 K, protein heavy atoms restrained
; Course standard: amber99sb-ildn + TIP3P, dt = 2 fs, h-bond constraints, no HMR

define          = -DPOSRES  ; position restraints from posre.itp
integrator      = md
dt              = 0.002     ; 2 fs
nsteps          = 50000     ; 100 ps

; Output
nstxout-compressed = 5000   ; every 10 ps
nstenergy       = 500
nstlog          = 500

; Bonds
continuation    = no        ; first dynamics stage after minimisation
constraints     = h-bonds
constraint-algorithm = lincs
lincs-iter      = 1
lincs-order     = 4

; Neighbour searching and interactions
cutoff-scheme   = Verlet
nstlist         = 10
pbc             = xyz
coulombtype     = PME
rcoulomb        = 1.0
vdwtype         = Cut-off
rvdw            = 1.0
DispCorr        = EnerPres

; Temperature coupling: one group for the whole system
tcoupl          = v-rescale
tc-grps         = System
tau-t           = 0.1
ref-t           = 300

; No pressure coupling in NVT
pcoupl          = no

; Initial velocities
gen-vel         = yes
gen-temp        = 300
gen-seed        = -1        ; a different random seed each run
